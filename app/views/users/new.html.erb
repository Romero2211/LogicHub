<section class="mx-auto max-w-md rounded-2xl border border-[#2a2a32] bg-[#1a1a1f] p-6 md:p-8">
  <h1 class="text-2xl font-bold">Регистрация</h1>
  <p class="mt-2 mb-6 text-sm text-[#94a3b8]">Создайте аккаунт, чтобы публиковать посты и комментировать.</p>

  <%= form_with model: @user, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <ul class="rounded-lg bg-red-500/15 px-4 py-3 text-sm text-red-200">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :email, class: label_classes %>
      <%= f.email_field :email, class: field_classes %>
    </div>
    <div>
      <%= f.label :password, "Пароль", class: label_classes %>
      <%= f.password_field :password, class: field_classes %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Подтверждение пароля", class: label_classes %>
      <%= f.password_field :password_confirmation, class: field_classes %>
    </div>
    <%= f.submit "Зарегистрироваться", class: "#{primary_button_classes} w-full" %>
  <% end %>

  <p class="mt-6 text-center text-sm text-[#94a3b8]">
    <%= link_to "Уже есть аккаунт? Войти", login_path, class: "text-[#7c3aed] hover:underline" %>
  </p>
</section>
