<article class="mb-4 flex gap-4 rounded-xl border border-[#2a2a32] bg-[#1a1a1f] p-5">
  <div class="min-w-0 flex-1">
    <%= link_to category_label(post.category), category_path(post.category),
        class: "inline-block rounded-md px-2 py-1 text-xs font-medium #{category_badge_classes(post.category)}",
        data: { turbo_frame: "_top" } %>
    <h2 class="mt-3 text-xl font-semibold">
      <%= link_to post.title, post_path(post), class: "hover:text-[#7c3aed]", data: { turbo_frame: "_top" } %>
    </h2>
    <p class="mt-2 text-[#94a3b8]"><%= truncate(post.body, length: 120) %></p>
    <p class="mt-3 flex flex-wrap items-center gap-3 text-sm text-[#94a3b8]">
      <span><%= post.user.email %> · <%= post.created_at.strftime("%d.%m.%Y") %></span>
      <span>💬 <%= post.comments.count %></span>
      <%= render "likes/button", record: post %>
    </p>
  </div>

  <% if post.image.attached? %>
    <%= link_to post, class: "hidden shrink-0 sm:block", data: { turbo_frame: "_top" } do %>
      <%= image_tag post.image, class: "h-24 w-32 rounded-lg object-cover" %>
    <% end %>
  <% end %>
</article>
