<section class="mx-auto max-w-2xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">Личный кабинет</h1>
    <%= link_to "Редактировать профиль", edit_profile_path, class: primary_button_classes %>
  </div>

  <div class="rounded-2xl border border-[#2a2a32] bg-[#1a1a1f] p-6 md:p-8">
    <div class="flex flex-wrap items-center gap-5">
      <%= user_avatar_tag current_user, size: 80, class_name: "h-20 w-20 text-2xl" %>
      <div>
        <p class="text-xl font-semibold text-white"><%= current_user.display_name %></p>
        <p class="mt-1 text-sm text-[#94a3b8]"><%= current_user.email %></p>
        <% if current_user.nickname.present? %>
          <p class="mt-1 text-sm text-[#7c3aed]">@<%= current_user.nickname %></p>
        <% else %>
          <p class="mt-2 text-sm text-amber-300/90">Никнейм ещё не задан — добавьте его в профиле.</p>
        <% end %>
      </div>
    </div>

    <dl class="mt-8 grid gap-4 border-t border-[#2a2a32] pt-6 text-sm sm:grid-cols-3">
      <div>
        <dt class="text-[#94a3b8]">Посты</dt>
        <dd class="mt-1 text-lg font-medium text-white"><%= current_user.posts.count %></dd>
      </div>
      <div>
        <dt class="text-[#94a3b8]">Комментарии</dt>
        <dd class="mt-1 text-lg font-medium text-white"><%= current_user.comments.count %></dd>
      </div>
      <div>
        <dt class="text-[#94a3b8]">Лайки</dt>
        <dd class="mt-1 text-lg font-medium text-white"><%= current_user.likes.count %></dd>
      </div>
    </dl>

    <% unless current_user.profile_complete? %>
      <p class="mt-6 rounded-lg border border-[#7c3aed]/40 bg-[#7c3aed]/10 px-4 py-3 text-sm text-[#cbd5e1]">
        Чтобы на карточках постов показывались аватар и никнейм, заполните профиль:
        <%= link_to "настроить сейчас", edit_profile_path, class: "text-[#7c3aed] hover:underline" %>.
      </p>
    <% end %>
  </div>
</section>
